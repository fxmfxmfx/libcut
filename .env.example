# Copy this file to .env and review the settings before starting Compose.
# Compose binds to loopback by default. Use a trusted network only; there is no login.
LIBCUT_BIND=127.0.0.1

# Demo data is enabled by default. Set false for live TikTok requests.
DEMO_MODE=true

# Proxy for TikTok requests, e.g. socks5://user:password@proxy.example:1080.
# Leave empty when no proxy is configured. Do not commit credentials.
TIKTOK_PROXY=

TIKTOK_CACHE_TTL_MIN=10
TIKTOK_SOCKET_TIMEOUT=30
TIKTOK_RETRIES=3

# local stores personal subscriptions/favorites/watched data in SQLite.
# client stores personal state/preferences in browser localStorage. Public
# TikTok metadata and server cache are still shared through the server database.
DATA_MODE=local

# Used by a local non-Docker run. Compose intentionally uses its named DB/cache volumes.
# For local production, set an absolute database path; see README.
DATABASE_URL=file:./dev.db
TIKTOK_CACHE_DIR=./cache/videos
